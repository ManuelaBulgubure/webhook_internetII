# Token que te entrega @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# Secreto que vos elegís para este proyecto (lo usa Telegram para probar
# que el POST viene realmente desde Telegram)
TELEGRAM_WEBHOOK_SECRET=

# Opcional: URL de la foto que usa el comando /saludar
BOT_PHOTO_URL=https://robohash.org/loro-tdi2-bot.png?size=512x512&set=set1

# Opcional: IDs de Telegram (separados por coma) que pueden usar /historial
ALLOWED_TELEGRAM_USER_IDS=
